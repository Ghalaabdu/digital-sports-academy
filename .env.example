# ================================================================
# أكاديمية الرياضة الرقمية — إعدادات الخادم
# انسخي هذا الملف إلى ملف باسم .env ثم عبّئي القيم
# ================================================================

# مفتاح سري طويل وعشوائي (غيّريه قبل التشغيل الفعلي)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# True أثناء التطوير على جهازك، False عند النشر
DJANGO_DEBUG=True
# أسماء النطاقات المسموح بها مفصولة بفواصل
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# عند النشر على نطاق: https://academy.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------- قاعدة البيانات PostgreSQL ----------
# اكتبي sqlite بدل postgres لتجربة سريعة بدون PostgreSQL
DB_ENGINE=postgres
DB_NAME=sports_academy
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------- البريد الإلكتروني (رموز التحقق) ----------
# Gmail: فعّلي التحقق بخطوتين ثم أنشئي "كلمة مرور التطبيقات" (16 حرفاً)
# إذا تركتِ EMAIL_HOST_USER فارغاً تُطبع الرسائل في الطرفية بدل إرسالها
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=أكاديمية الرياضة الرقمية <no-reply@example.com>

# ---------- المدربة الذكية (Google Gemini) ----------
# من https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# بدائل تلقائية عند الضغط المؤقت (مفصولة بفواصل)
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash

# ---------- سياسة الخطوات ----------
# True: الإدخال اليدوي يتطلب صورة إثبات ويبقى "قيد المراجعة" حتى تعتمده المعلمة
STEPS_REQUIRE_PROOF=True
# أقصى عدد خطوات يُقبل في إدخال واحد
STEPS_MAX_PER_ENTRY=60000
